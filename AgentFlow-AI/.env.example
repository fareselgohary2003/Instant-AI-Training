# AI Task Agent - Environment Configuration

# Core LLM Provider (Groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# SMTP Provider for Email Agent (Required only for sending emails after approval)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SENDER_EMAIL=your_email@gmail.com

# Web Search Provider (Optional - uses Tavily API if set, otherwise falls back to DuckDuckGo)
TAVILY_API_KEY=your_tavily_api_key_here

# Allowed CORS Origins (comma-separated, optional)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000,http://localhost:8001,http://127.0.0.1:8001
