*.mp4
*.avi
*.mov
outputs/*
!outputs/.gitkeep
uploads/*
!uploads/.gitkeep
alerts/screenshots/*
!alerts/screenshots/.gitkeep

# Ultralytics runs & cache
runs/

# Secrets & Environment variables
.env
.env.*
*.env

# OS-generated files
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
