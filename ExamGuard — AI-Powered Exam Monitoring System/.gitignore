# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Caches and tests
.pytest_cache/
.coverage
htmlcov/

# Environments
.venv/
venv/
ENV/
env/

# Node / Vite frontend
node_modules/
frontend/node_modules/
dist/
frontend/dist/
frontend/.vite/

# Database files
*.db
*.sqlite
*.sqlite3
cheating_system.db

